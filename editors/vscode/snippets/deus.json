{
  "DEUS program": {
    "prefix": "genesis",
    "body": ["genesis", "${1:bind value = null}", "halt"],
    "description": "Create a complete DEUS program"
  },
  "Bind value": {
    "prefix": "bind",
    "body": "bind ${1:name} = ${2:null}",
    "description": "Bind an immutable value"
  },
  "Emit value": {
    "prefix": "emit",
    "body": ["load ${1:value}", "emit"],
    "description": "Load and emit a value"
  },
  "HTTP retrieval": {
    "prefix": "hunt",
    "body": ["omni \"net.http2\"", "genesis", "limit ${1:4}", "bind page = hunt \"${2:https://example.test}\"", "bind result = reap page \"${3:h1}\"", "load result", "emit", "halt"],
    "description": "Create a capability-bound HTTP retrieval flow"
  },
  "Record": {
    "prefix": "record",
    "body": ["{", "  \"${1:key}\": ${2:value}", "}"],
    "description": "Create a record literal"
  }
}
